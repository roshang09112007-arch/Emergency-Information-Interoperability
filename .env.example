# =============================================================================
# PulseKey Emergency Health Exchange - Environment Configuration
# =============================================================================

# AI Engine API Key (Required for Gemini Multi-Agent Trauma Conflict Reconciliation)
# Supports GEMINI_API_KEY, AI_API_KEY, or GOOGLE_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# JWT Secret for Hospital Institutional Authentication Sessions
JWT_SECRET=pulsekey-emergency-jwt-secret-2026-production

# MySQL Database Configuration (Cloud / Local)
# Supports full connection URL (e.g. Railway, PlanetScale, Aiven, AWS RDS, TiDB) or individual params:
MYSQL_URL=mysql://user:password@host:3306/pulsekey?ssl={"rejectUnauthorized":false}
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pulsekey
MYSQL_SSL=true

# Application Mode
NODE_ENV=production
